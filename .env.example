# Build-time mode only. npm run dev defaults to dev; production builds default to study.
# Explicitly set dev for an independently hosted debug build.
# VITE_RUN_MODE=dev
VITE_DEV_STORAGE=local

# Optional cloud testing: use a separate Firebase project with firestore.dev.rules.
# VITE_DEV_STORAGE=cloud
VITE_DEV_FIREBASE_API_KEY=
VITE_DEV_FIREBASE_AUTH_DOMAIN=
VITE_DEV_FIREBASE_PROJECT_ID=
VITE_DEV_FIREBASE_APP_ID=

# Formal Study build: configure web app + Anonymous Auth + firestore.rules.
VITE_STUDY_FIREBASE_API_KEY=
VITE_STUDY_FIREBASE_AUTH_DOMAIN=
VITE_STUDY_FIREBASE_PROJECT_ID=
VITE_STUDY_FIREBASE_APP_ID=
VITE_STUDY_CONSENT_VERSION=
VITE_STUDY_CONSENT_TEXT=
VITE_COMPLETION_URL=

# Optional completion code; defaults to the cc parameter in VITE_COMPLETION_URL.
VITE_COMPLETION_CODE=
