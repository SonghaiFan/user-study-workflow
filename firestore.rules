rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deploy only to the formal study Firebase project.
    match /studySessions/{owner}/sessions/{key} {
      function owns() { return request.auth != null && request.auth.uid == owner; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ownerUid', 'runMode', 'revision', 'studyId', 'studyVersion', 'sessionId', 'payload'])
          && d.ownerUid == owner && d.runMode == 'study'
          && d.revision is int && d.revision >= 0
          && d.studyId is string && d.studyVersion is string && d.sessionId is string
          && d.payload is string && d.payload.size() < 950000;
      }
      allow get: if owns();
      allow create: if owns() && valid() && request.resource.data.revision == 0;
      allow update: if owns() && valid()
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.studyId == resource.data.studyId
        && request.resource.data.studyVersion == resource.data.studyVersion
        && request.resource.data.sessionId == resource.data.sessionId;
      // No participant listing, deletion, or access to another participant's sessions.
    }
  }
}
